# App
APP_NAME=GenZ Finance Co-Pilot
APP_ENV=development
DEBUG=false

# Auth
# NOTE: must be >= 32 chars
SECRET_KEY=change-me-to-a-long-random-string-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ALGORITHM=HS256

# MongoDB
# Local MongoDB
# MONGODB_URL=mongodb://localhost:27017

# MongoDB Atlas (SRV)
# NOTE: `mongodb+srv://` requires the `dnspython` package to be installed.
# If your password contains special characters (@, :, /, ?), URL-encode it.
MONGODB_URL=sample url
MONGODB_DB_NAME=genz_finance

# Google Cloud / Agent Builder
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
AGENT_BUILDER_AGENT_ID=your-agent-id
# Optional: locally; on Cloud Run use ADC
GOOGLE_APPLICATION_CREDENTIALS=

# Elastic
ELASTIC_CLOUD_ID=your-elastic-cloud-id
ELASTIC_API_KEY=your-elastic-api-key
ELASTIC_INDEX_NAME=indian_finance_knowledge

# Rate limiting
RATE_LIMIT_PER_MINUTE=30

# CORS (JSON array string)
ALLOWED_ORIGINS='["http://localhost:5173","https://your-app.web.app"]'

# Optional Redis (shared rate limiting)
# REDIS_URL=redis://:password@host:6379/0

